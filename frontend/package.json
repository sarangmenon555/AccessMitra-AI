{
  "name": "accessmitra-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "start:worker": "wrangler dev",
    "test:worker": "vitest run",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "deploy": "next build && wrangler deploy"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}